#!/usr/bin/env bash
# Refuse a push that would send a secret, and any push from an SSSF agent.
# Git runs this before every push, with the remote's name in $1 and one line
# per ref on stdin. It scans only the commits the push would send: those past
# the remote's copy of the ref, or, for a new branch, those on no branch of
# that remote yet. gitleaks prints each find redacted, with its rule, file and
# commit. That needs --verbose: without it, gitleaks prints only a count.
# Stamped by SSSF's install.py. Set up once per clone:
# git config core.hooksPath .githooks
# It needs gitleaks 8.30.1 or later on PATH: https://github.com/gitleaks/gitleaks
# More in SSSF's cookbooks/install.md, "Secret scan before every push".
#
# It also refuses a push whose commits name a private project, in a message
# or an added line, when the clone lists it in .git/sssf-private-names, one
# per line, # for comments. The list lives in .git, so it's never committed.
# Without it, nothing is checked. Case is ignored.
set -uo pipefail
zero=0000000000000000000000000000000000000000
if [ -n "${SSSF_ADW_ID:-}" ]; then
  echo "pre-push: SSSF_ADW_ID is set ($SSSF_ADW_ID${SSSF_AGENT:+, agent $SSSF_AGENT}), so an SSSF agent is pushing. Agents commit locally only; the engineer pushes." >&2
  exit 1
fi
if ! command -v gitleaks >/dev/null; then
  echo "pre-push: gitleaks isn't installed, so this push is refused. Install gitleaks 8.30.1 or later (https://github.com/gitleaks/gitleaks), or push with --no-verify knowing nothing was scanned." >&2
  exit 1
fi
# The names, or nothing. An empty list would match every line.
names_file="$(git rev-parse --git-common-dir)/sssf-private-names"
names=""
[ -f "$names_file" ] && names="$(grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$names_file" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
found=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha --not --remotes=$1"; else range="$remote_sha..$local_sha"; fi
  if [ -n "$names" ]; then
    for commit in $(git rev-list $range); do
      # The message and the lines it adds. A removed line doesn't send the
      # name anywhere new, and taking a name out must be allowed.
      hits="$({ git show -s --format='%B' "$commit"; git show --format= --patch "$commit" | grep '^+'; } | grep -o -i -F -f <(printf '%s\n' "$names") | sort -fu | paste -sd, -)"
      if [ -n "$hits" ]; then
        echo "pre-push: commit $(git rev-parse --short "$commit") names a private project ($hits), in its message or its changes, so $local_ref wasn't pushed to $1. The names are listed in $names_file." >&2
        found=1
      fi
    done
  fi
  if ! gitleaks git --no-banner --redact --verbose --log-level warn --log-opts="$range" .; then
    echo "pre-push: gitleaks found a secret in what $local_ref would send to $1 $remote_ref. Nothing was pushed. Remove it from those commits, then push again." >&2
    found=1
  fi
done
exit $found
