#!/usr/bin/env bash
# Refuse a push that would send a secret. Git runs this before every push,
# with the remote's name in $1 and one line per ref on stdin. It scans only the
# commits the push would send: those past the remote's copy of the ref, or, for
# a new branch, those on no branch of that remote yet. gitleaks prints each find,
# redacted, with its rule, file and commit. That needs --verbose: without it,
# gitleaks prints only a count. Set up once per clone:
# git config core.hooksPath .githooks
# (docs/going-private.md, "What stops a leak").
set -uo pipefail
zero=0000000000000000000000000000000000000000
if ! command -v gitleaks >/dev/null; then
  echo "pre-push: gitleaks isn't installed, so this push is refused. Install it (docs/going-private.md), or push with --no-verify knowing nothing was scanned." >&2
  exit 1
fi
found=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue          # deleting a ref sends nothing
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes=$1"
  else
    range="$remote_sha..$local_sha"
  fi
  if ! gitleaks git --no-banner --redact --verbose --log-level warn --log-opts="$range" .; then
    echo "pre-push: gitleaks found a secret in what $local_ref would send to $1 $remote_ref. Nothing was pushed. Remove it from those commits, then push again." >&2
    found=1
  fi
done
exit $found
