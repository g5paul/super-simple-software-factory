# agentsh policy server for SSSF's local agents.
# It runs as its own user, so an agent cannot change its config, stop it
# or start a second copy with CAP_SYS_PTRACE.
[Unit]
Description=agentsh policy server for SSSF agents
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=agentsh
Group=agentsh
ExecStart=/usr/bin/agentsh server --config /etc/agentsh/sssf.yaml
WorkingDirectory=/var/lib/agentsh
# State survives a restart. /run is cleared at each WSL boot.
StateDirectory=agentsh
StateDirectoryMode=0750
RuntimeDirectory=agentsh
RuntimeDirectoryMode=0755
# The per-wrap handshake sockets go here, where wrap can reach them and
# no other user can write.
Environment=TMPDIR=/run/agentsh
# CAP_SYS_PTRACE lets the tracer attach to an agent of another user.
# CAP_DAC_READ_SEARCH lets it open the agent's /proc/<pid>/mem, which is
# mode 0600, and reach workspaces in a home folder that is mode 0750.
AmbientCapabilities=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
